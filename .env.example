# -----------------------------------------------------------------------
# Anchal — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# -----------------------------------------------------------------------

# Postgres connection string. Works with Neon, Supabase, Railway, or a
# local Postgres instance. Include ?sslmode=require for most hosted DBs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Used by next-auth v4-style env detection in some tooling; safe to keep
# equal to AUTH_SECRET.
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# The canonical URL of your deployment (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# Razorpay — from the Razorpay Dashboard > Settings > API Keys.
# Use test mode keys (rzp_test_...) until you're ready to go live.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-your-razorpay-key-secret"
# From Dashboard > Settings > Webhooks, after creating a webhook pointed
# at /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET="replace-with-your-webhook-secret"

# Cloudinary — from the Cloudinary Dashboard.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional: only needed if/when the admin sends transactional email
# (order confirmations, password reset). Not required to run the app.
# RESEND_API_KEY=""
# EMAIL_FROM="Anchal <orders@yourdomain.com>"
